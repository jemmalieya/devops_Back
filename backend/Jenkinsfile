
pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Recuperation du code depuis GitHub'

                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/jemmalieya/devops_Back.git'
            }
        }

        stage('Clean and Test') {
            steps {
                dir('backend') {
                    echo 'Execution de Maven Clean et Test'
                    sh './mvnw clean test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('backend') {
                    echo 'Creation du package'
                    sh './mvnw package -DskipTests'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline termine avec succes !'
        }

        failure {
            echo 'Echec du pipeline !'
        }

        always {
            echo 'Fin du pipeline'
        }
    }
}
