
pipeline {
    agent any

    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    triggers {
        githubPush()
    }

    stages {

        // Stage 1 : Recuperation du projet
        stage('Recuperation du projet') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/jemmalieya/devops_Back.git'
            }
        }

        // Stage 2 : Generation du livrable
        stage('Generation du livrable') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'backend/target/*.jar',
                             fingerprint: true

            echo 'BUILD SUCCESS - Livrable genere avec succes !'
        }

        failure {
            echo 'BUILD FAILURE - Erreur dans le pipeline !'
        }
    }
}
